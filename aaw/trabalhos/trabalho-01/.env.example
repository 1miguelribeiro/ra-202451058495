# Modelo das variaveis de ambiente.

MONGO_USER=usuario_admin
MONGO_PASSWORD=definir_senha_aqui

# Endereco do banco que a API usa
MONGODB__CONNECTIONSTRING=mongodb://usuario_admin:definir_senha_aqui@localhost:27017/?authSource=admin
MONGODB__DATABASE=loja_retro

# Chave que assina os tokens JWT (minimo 32 caracteres)
JWT__KEY=trocar_por_uma_chave_aleatoria_com_32_ou_mais_caracteres

# Admin criado automaticamente na primeira vez que a API sobe
ADMIN__EMAIL=admin@lojaretro.com
ADMIN__SENHA=definir_senha_aqui
